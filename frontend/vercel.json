{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|gif|svg|webp|js|css|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "forgeindiaconnect.com"
        }
      ],
      "destination": "https://www.forgeindiaconnect.com/$1",
      "permanent": true
    },
    { "source": "/app-development.html", "destination": "/app-development", "permanent": true },
    { "source": "/digital-marketing.html", "destination": "/digital-marketing", "permanent": true },
    { "source": "/insurance-services.html", "destination": "/insurance-services", "permanent": true },
    { "source": "/job-consulting.html", "destination": "/job-consulting", "permanent": true },
    { "source": "/refund-policy.html", "destination": "/refund-policy", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/api/fic-socket/(.*)",
      "destination": "http://3.221.160.61:5001/api/fic-socket/$1"
    },
    {
      "source": "/api/:path*",
      "destination": "http://3.221.160.61:5001/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "http://3.221.160.61:5001/uploads/:path*"
    },
    {
      "source": "/((?!api|uploads|assets).*)",
      "destination": "/index.html"
    }
  ]
}
